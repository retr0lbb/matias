GEMINI_API_KEY=YOUR_API_KEY
# Free tier: 30000 embed tokens/minute. Raise if your plan allows.
EMBEDDING_TOKENS_PER_MINUTE=30000
CHEAP_PROVIDER_KEY=YOUR_API_KEY
EXPENSIVE_PROVIDER_KEY=YOUR_API_KEY
DATABASE_URL=postgresql://docker:docker@localhost:5432/matias
APP_URL=http://localhost:3000
GOOGLE_REDIRECT_URL=YOUR_GOOGLE_REDIRECT
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Asaas (sandbox key starts with $aact_hmlg_; wrap in single quotes because of the $)
ASAAS_API_KEY='YOUR_ASAAS_API_KEY'
ASAAS_WALLET_ID=
ASAAS_API_URL=https://api-sandbox.asaas.com/v3
# Same value as the webhook "authentication token" configured on Asaas (32-255 chars, no spaces).
# Asaas sends it in the asaas-access-token header of POST /webhooks/asaas.
ASAAS_WEBHOOK_TOKEN=